# Configuración del frontend en LiteSpeed (DirectAdmin).
#
# Deliberadamente mínima. La versión anterior traía cabeceras de seguridad,
# compresión y reglas de caché, y LiteSpeed la rechazaba entera: el sitio
# respondía 404 hasta quitar el archivo. Un .htaccess que el servidor no acepta
# no falla en la línea problemática, falla completo.
#
# Se agregan bloques de a uno y se comprueba que el sitio siga en pie.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Todo lo que no exista como archivo o carpeta va a index.html.
    #
    # La aplicación usa el hash de la URL para sus pestañas, así que hoy no hay
    # rutas que reescribir y esto no hace falta. Va para el día que sí las haya:
    # sin la regla, entrar directo a una daría 404 sin explicar por qué.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>
