# Dependencias: se reconstruyen con composer install / npm install
node_modules/
vendor/

# Credenciales: nunca al repositorio, sólo las plantillas sin valores.
# La negación va con comodín y no sólo para `.env.example`, porque también hay
# `.env.production.example`, que documenta qué variables pide el hosting.
.env
.env.*
!.env*.example

# Compilados del frontend
dist/
build/

# Volcado del esquema: se genera con `php artisan construprec:esquema-sql`.
# No se versiona porque la fuente de verdad son las migraciones, y una copia
# versionada terminaría quedando vieja sin que nadie lo note.
backend/docs/esquema.sql

# Paquetes listos para subir al hosting. Se generan con scripts/empaquetar.sh y
# pesan diez megas: se rehacen en un minuto y no tienen por qué versionarse.
dist-despliegue/

# Sistema operativo y editores
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Herramientas de IA: configuración local de cada quien, no del proyecto
CLAUDE.md
CLAUDE.local.md
.claude/
.mcp.json
