# Plantilla del .env del hosting. Copiar como .env en la RAÍZ del proyecto,
# que queda FUERA de public_html: si el .env es alcanzable por web, la clave de
# la base de datos y la APP_KEY quedan a la vista de cualquiera.
#
# Los valores reales no van acá ni en ningún archivo del repositorio.

APP_NAME=Construprec
APP_ENV=production

# Se genera en el servidor con `php artisan key:generate`. No se copia la del
# entorno local: con la misma clave, quien tenga una puede descifrar las sesiones
# y los tokens firmados del otro.
APP_KEY=

# En false, siempre. Con debug activo, cualquier error muestra la traza completa
# —rutas del servidor, consultas, fragmentos del .env— a quien provoque el fallo.
APP_DEBUG=false

APP_URL=https://api.construprec.surcode.cl
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL
APP_TIMEZONE=America/Santiago

# En producción sólo se registra lo que hay que mirar. Con `debug` el log crece
# rápido y en hosting compartido la cuota de disco se llena.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sin Redis ni procesos permanentes: todo a la base de datos.
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Dominios que pueden llamar a la API desde un navegador, separados por coma.
# Sin comodín: con '*', cualquier sitio que el usuario tenga abierto puede
# pedirle datos a la API en su nombre.
CORS_ORIGINS=https://construprec.surcode.cl

# La documentación de la API (/docs/api) NO necesita variable: Scramble la cierra
# sola cuando el entorno no es `local`, devolviendo 403 salvo que se defina un
# permiso `viewApiDocs`. Basta con que APP_ENV sea production.
